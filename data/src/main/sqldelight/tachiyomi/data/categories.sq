CREATE TABLE categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    content_type INTEGER NOT NULL DEFAULT 0
);

-- Insert system category
INSERT OR IGNORE INTO categories(_id, name, sort, flags, content_type) VALUES (0, "", -1, 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON categories
BEGIN SELECT CASE
    WHEN old._id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
SELECT *
FROM categories
WHERE _id = :id
LIMIT 1;

getCategories:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type
FROM categories
ORDER BY sort;

getCategoriesByMangaId:
SELECT
C._id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.content_type
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id = :mangaId;

-- Batch fetch categories for multiple manga IDs - optimized for duplicate detection
getCategoriesByMangaIds:
SELECT
MC.manga_id,
C._id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.content_type
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id IN :mangaIds
ORDER BY MC.manga_id, C.sort;

getCategoriesByContentType:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type
FROM categories
WHERE content_type = :contentType OR content_type = 0
ORDER BY sort;

insert:
INSERT INTO categories(name, sort, flags, content_type)
VALUES (:name, :order, :flags, :contentType);

delete:
DELETE FROM categories
WHERE _id = :categoryId;

updateName:
UPDATE categories
SET name = :name
WHERE _id = :categoryId;

updateOrder:
UPDATE categories
SET sort = :order
WHERE _id = :categoryId;

updateContentType:
UPDATE categories
SET content_type = :contentType
WHERE _id = :categoryId;

getMangaIdsNotMatchingType:
SELECT MC.manga_id
FROM mangas_categories MC
JOIN mangas M ON M._id = MC.manga_id
WHERE MC.category_id = :categoryId AND M.is_novel != :isNovel;

deleteMangaNotMatchingType:
DELETE FROM mangas_categories
WHERE category_id = :categoryId AND manga_id IN (
    SELECT _id FROM mangas WHERE is_novel != :isNovel
);

updateFlags:
UPDATE categories
SET flags = :flags
WHERE _id = :categoryId;

updateAllFlags:
UPDATE categories SET
flags = coalesce(:flags, flags);

selectLastInsertedRowId:
SELECT last_insert_rowid();
