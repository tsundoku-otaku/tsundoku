-- SQLite max() returns NULL if any argument is NULL. history.last_read is nullable, so a NULL
-- readAt (e.g. from backup restore history merging) poisoned this UPDATE and violated
-- mangas.last_read NOT NULL. Guard with ifnull.
DROP TRIGGER IF EXISTS manga_agg_history_upsert;
DROP TRIGGER IF EXISTS manga_agg_history_update;

CREATE TRIGGER manga_agg_history_upsert
AFTER INSERT ON history
BEGIN
    UPDATE mangas SET
        last_read = max(last_read, ifnull(CAST(new.last_read AS INTEGER), 0))
    WHERE _id = (SELECT manga_id FROM chapters WHERE _id = new.chapter_id)
    AND favorite = 1;
END;

CREATE TRIGGER manga_agg_history_update
AFTER UPDATE OF last_read ON history
BEGIN
    UPDATE mangas SET
        last_read = max(last_read, ifnull(CAST(new.last_read AS INTEGER), 0))
    WHERE _id = (SELECT manga_id FROM chapters WHERE _id = new.chapter_id)
    AND favorite = 1;
END;
